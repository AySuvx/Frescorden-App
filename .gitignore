# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Salida de Gradle (reportes, .transforms, etc.) — no cubierta por /build/
# de la raíz, que solo apunta al build/ de Flutter.
/android/build/

# Firebase local options
lib/firebase_options.dart

# Secrets / local config (defense in depth: android/.gitignore, ios/.gitignore,
# etc. already cover their module-local copies of some of these; estas reglas
# a nivel de raíz cubren cualquier otra ubicación, presente o futura).
.env
.env.*
!.env.example
*.keystore
*.jks
*.p12
key.properties
**/local.properties
secrets.yaml
secrets.json

# graphify: salida generada localmente por el skill de knowledge-graph,
# no es código fuente del proyecto.
graphify-out/

# Config local de Claude Code (permisos/preferencias de esta máquina, ej.
# worktree.baseRef) — nunca compartida entre desarrolladores.
.claude/settings.local.json

# Estado en vivo del wrap de Headroom (PID, puerto, timestamps del proceso
# de ESTA máquina/sesión) — no es configuración del proyecto, cambia en
# cada ejecución y no tiene ningún valor para otro desarrollador.
.claude/.headroom_wrap_marker.json
.claude/.headroom_wrap_owners.json
.claude/.headroom_wrap_settings.lock

# Documentación de la monografía: se maneja fuera del repo de código.
docs/