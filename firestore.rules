rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Panel Administrativo Global: UID único con acceso a métricas
    // agregadas de toda la app (ver lib/config/app_config.dart kAdminUid —
    // las reglas no pueden importar ese valor, se repite acá literal).
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'YMpWzkKQFiMvCqJdYDYX9fZe5Ow2';
    }

    // Permitir acceso a los documentos de la colección "usuarios"
    match /usuarios/{userId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;

      // Panel Administrativo Global: el UID admin puede LISTAR esta
      // colección para calcular altas/usuarios activos recientes
      // (createdAt/lastActiveAt — los únicos campos propios de este
      // documento, ver UserModel) — nunca leer la cuenta de otro por su
      // propia cuenta, que sigue exigiendo `request.auth.uid == userId`.
      allow list: if isAdmin();
    }

    // Legacy (pre-Household): inventario por usuario individual. Se
    // conserva de solo lectura/escritura para el propio dueño porque
    // bootstrapPersonalHousehold copia (no borra) estos documentos al
    // migrar a households/{id}/productos — quedan como respaldo.
    match /usuarios/{userId}/productos/{productId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Permitir acceso al historial dentro de cada usuario
    // Historial de Productos: registro de consumo a tiempo vs.
    // vencido, usado por AnalyticsRepositoryImpl para calcular los KPIs.
    match /usuarios/{userId}/historial/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Módulo de Grupos Familiares (Household) ──────────────────────────
    //
    // Los IDs de documento de Firestore son strings aleatorios de 20+
    // caracteres, no enumerables ni adivinables: permitir `get` (lectura
    // puntual por ID ya conocido) a cualquier usuario autenticado es el
    // patrón estándar de Firestore para "quien tiene el enlace/ID puede
    // verlo" — necesario porque quien se está uniendo a un hogar todavía
    // NO es miembro en el momento de leerlo por primera vez. `list`
    // (queries) sobre la colección completa SÍ se deniega: la app nunca
    // necesita listar todos los hogares, solo leer uno por ID conocido.
    match /households/{householdId} {
      // Auditoría de seguridad (Fase 6, Módulo 2): decisión de diseño
      // aceptada, no un hallazgo pendiente. `get` puntual por ID conocido
      // se mantiene abierto a cualquier autenticado — es el único modo en
      // que alguien uniéndose a un hogar (todavía no-miembro) puede leerlo.
      // Restringirlo a "solo miembros" exigiría separar los datos públicos
      // de invitación (nombre, conteo de miembros) del documento completo
      // en una colección aparte — cambio de arquitectura fuera de alcance
      // de esta auditoría. `list` (enumerar TODOS los hogares) sí queda
      // denegado por defecto: la superficie de ataque real (enumeración
      // masiva) está cerrada; solo "quien ya tiene el ID/enlace" puede
      // leer un hogar puntual, igual que el patrón de `inviteCodes` abajo.
      allow get: if request.auth != null;
      allow list: if false;

      // Panel Administrativo Global: el UID admin puede LISTAR todos los
      // hogares para calcular métricas agregadas de uso (total de hogares,
      // miembros totales/promedio, códigos vencidos) — ver
      // FirestoreAdminDataSource.getGlobalStats.
      allow list: if isAdmin();

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy
        && request.resource.data.members is list
        && request.resource.data.members == [request.auth.uid];

      // Dos casos permitidos:
      //  1) Ya soy miembro: puedo actualizar libremente (nombre, código de
      //     invitación, etc.).
      //  2) Me estoy uniendo: los ÚNICOS cambios permitidos son agregarme a
      //     mí mismo (y solo a mí) al final de `members`, y anotar mi email
      //     en `memberEmails` (denormalizado para mostrar la lista de
      //     miembros en la UI sin leer perfiles ajenos) — nada más.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        (
          request.resource.data.members == resource.data.members.concat([request.auth.uid]) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberEmails'])
        )
      );

      allow delete: if false;

      // Inventario compartido del hogar: cualquier miembro lee/escribe.
      // La membresía se resuelve leyendo el documento padre (mismo patrón
      // documentado en las reglas oficiales de Firestore para
      // subcolecciones con control de acceso basado en el padre).
      match /productos/{productId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }

      // Registro de Actividad: log de auditoría de solo escritura
      // (append-only) — cualquier miembro puede crear/leer eventos, nadie
      // puede modificar ni borrar uno ya escrito.
      match /activity_log/{entryId} {
        allow read, create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
        allow update, delete: if false;
      }

      // Historial de Productos resueltos (consumidos o desperdiciados, ver
      // ProductOutcome) — base de AnalyticsRepositoryImpl. Reemplaza la
      // colección legacy usuarios/{uid}/historial: ahora vive por-hogar,
      // igual que el inventario y el activity_log.
      match /product_history/{entryId} {
        allow read, create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
        allow update, delete: if false;
      }

      // Adopción del Asistente Culinario: un documento por consulta
      // exitosa (append-only, mismo patrón que activity_log/product_history)
      // — base de las métricas de uso del Panel Administrativo Global.
      match /assistant_usage/{entryId} {
        allow read, create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
        allow update, delete: if false;
      }
    }

    // Panel Administrativo Global: consultas collectionGroup (cruzan TODOS
    // los hogares) para las métricas agregadas de aprovechamiento y de
    // adopción del asistente — ver FirestoreAdminDataSource.getGlobalStats.
    // Las reglas por-hogar de arriba (`match /households/{id}/product_history`
    // y `/assistant_usage`) siguen rigiendo cualquier lectura acotada a un
    // solo hogar; esto SOLO habilita la query que cruza todos.
    match /{path=**}/product_history/{entryId} {
      allow list: if isAdmin();
    }
    match /{path=**}/assistant_usage/{entryId} {
      allow list: if isAdmin();
    }

    // Lookup de código de invitación → householdId. Colección aparte (en
    // vez de una query `where('inviteCode', ...)` sobre /households) por
    // la razón documentada arriba de las reglas de Household: una `list`
    // restringida a miembros no puede usarse para encontrar un hogar en el
    // que TODAVÍA no soy miembro ("rules are not filters" — Firestore
    // deniega la query completa si no puede garantizar el resultado para
    // cualquier documento que pudiera matchear).
    //
    // El código en sí (6 caracteres, ver InviteCodeGenerator) es el ID del
    // documento: no enumerable por fuerza bruta razonable, así que un
    // `get` público (cualquier autenticado) es seguro — equivalente a
    // "quien tiene el código puede consultarlo". La vigencia real
    // (¿expiró? ¿fue rotado?) se valida aparte contra el campo
    // `inviteCode`/`codeExpiresAt` VIGENTE del documento Household — un
    // código viejo cuyo lookup nunca se borró simplemente deja de
    // coincidir después de una rotación.
    match /inviteCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.resource.data.householdId is string
        && request.auth.uid in get(
             /databases/$(database)/documents/households/$(request.resource.data.householdId)
           ).data.members;
      allow delete: if false;
    }
  }
}
